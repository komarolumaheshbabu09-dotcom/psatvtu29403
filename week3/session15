import java.util.*;

class Solution {
    public String[] sortPeople(String[] names, int[] heights) {

        for (int i = 0; i < heights.length; i++) {
            for (int j = i + 1; j < heights.length; j++) {

                if (heights[i] < heights[j]) {

                    // swap heights
                    int temp = heights[i];
                    heights[i] = heights[j];
                    heights[j] = temp;

                    // swap names
                    String t = names[i];
                    names[i] = names[j];
                    names[j] = t;
                }
            }
        }

        return names;
    }
}
Input
names =
["Mary","John","Emma"]
heights =
[180,165,170]
Output
["Mary","Emma","John"]
Expected
["Mary","Emma","John"]
